# WiFiBoy 6-bit VGA PMOD 腳位（修正版：依「標示順序反轉」規律，p1~p9 = R1,R0,G1,G0,B1,B0,VS,HS,Snd）
set_io -nowarn r1  42    # R1 = p1
set_io -nowarn r0  43    # R0 = p2
set_io -nowarn g1  44    # G1 = p3
set_io -nowarn g0  45    # G0 = p4
set_io -nowarn b1  46    # B1 = p5
set_io -nowarn b0  47    # B0 = p6
set_io -nowarn vs  48    # VS = p7
set_io -nowarn hs  2     # HS = p8
set_io -nowarn snd 3     # Snd = p9
set_io -nowarn clk12 35
